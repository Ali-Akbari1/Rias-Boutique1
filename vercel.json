{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "riasboutique.com"
        }
      ],
      "destination": "https://www.riasboutique.com/$1",
      "permanent": true
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/health",
      "dest": "/api/order-status?health=1"
    },
    {
      "src": "/(checkout|checkout/success|checkout/cancel|orders-admin)/?",
      "dest": "/app.html"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
